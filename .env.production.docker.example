# ========================
# AIRISLENS - PRODUCTION ENV
# ========================
# Salin file ini ke .env.production dan isi semua nilai di bawah.
# JANGAN commit file .env.production ke git.

# Database di host VPS. `docker-compose.yml` sudah memberi alias
# `host.docker.internal` agar container bisa mengakses MySQL host.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=airislens
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
DB_NAME=airislens

# App Security
# Generate: openssl rand -base64 64
JWT_SECRET=GANTI_DENGAN_SECRET_PANJANG_DAN_RANDOM

# Generate: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=GANTI_DENGAN_BASE64_32_BYTE

# Path upload (sesuai docker volume)
UPLOAD_ROOT=/var/lib/airislens/uploads

# App URL
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN.COM

# Bootstrap Superadmin
# Isi hanya saat pertama kali setup, bisa dihapus setelahnya.
SUPERADMIN_NAME=Admin
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=GANTI_PASSWORD_ADMIN

# Midtrans
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
SERVICE_FEE_RATE=0.03

# WhatsApp (Fonnte)
FONNTE_TOKEN=
ADMIN_WA=

# OpenRouter (AI Chat)
OPENROUTER_API_KEY=

# Firebase Web Push
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AirisLens <noreply@yourdomain.com>
